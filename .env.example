# ═══════════════════════════════════════════════════════════════════
# LiveKit
# ═══════════════════════════════════════════════════════════════════
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_api_key
LIVEKIT_API_SECRET=your_api_secret

# Your RunPod pod ID running Unmute (e.g. h7a6hmafylm8li)
UNMUTE_POD_ID=your_pod_id
# Optional: a specific Unmute voice id. Leave blank to use the server default.
UNMUTE_VOICE=

# ═══════════════════════════════════════════════════════════════════
# CRM (HubSpot)
# ═══════════════════════════════════════════════════════════════════
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_TAXI_OBJECT_TYPE=
HUBSPOT_LAUNDRY_OBJECT_TYPE=
HUBSPOT_FOOD_OBJECT_TYPE=
HUBSPOT_MAINTENANCE_OBJECT_TYPE=
HUBSPOT_PAYMENT_OBJECT_TYPE=
HUBSPOT_TRANSCRIPT_OBJECT_TYPE=
HUBSPOT_GUEST_OBJECT_TYPE=
HUBSPOT_DRIVER_OBJECT_TYPE=

# Ollama endpoint used for CRM intent extraction (Phi-3 Mini).
OLLAMA_URL=http://localhost:11434/api/chat

# CRM worker folders/timing.
CRM_TRANSCRIPTS_DIR=transcripts
CRM_OUTPUTS_DIR=crm_outputs
CRM_POLL_INTERVAL=2
CRM_QUIET_PERIOD=10

# ═══════════════════════════════════════════════════════════════════
# PayU Credentials
# Sign up: https://payu.in/business  |  Test creds: https://devguide.payu.in/
# ═══════════════════════════════════════════════════════════════════
PAYU_MERCHANT_KEY=your_test_merchant_key
PAYU_MERCHANT_SALT=your_test_merchant_salt
PAYU_MODE=test

PAYU_TEST_URL=https://test.payu.in/_payment
PAYU_PROD_URL=https://secure.payu.in/_payment
PAYU_TEST_VERIFY_URL=https://test.payu.in/merchant/postservice?form=2
PAYU_PROD_VERIFY_URL=https://info.payu.in/merchant/postservice?form=2

# The PayU router is now mounted INSIDE token-api (port 8081 on the host,
# see docker-compose.yml). BASE_URL must be the address PayU/guests can
# actually reach for payment pages + webhooks — NOT localhost once this is
# public. It also must NOT be the old standalone port 9000 anymore.
BASE_URL=http://localhost:8081

# Comma-separated list of origins allowed to call the billing API from a
# browser. Leave empty to block all browser origins. NEVER use "*" in prod.
ALLOWED_ORIGINS=

# REQUIRED in production. Every /api/* PayU route then requires this in the
# X-API-Key header. Generate one with:
#   python -c "from app.payments.config import generate_api_key as g; print(g())"
PAYU_WORKER_API_KEY=

# Hotel / business info (shared with the PayU bill text + payment page)
HOTEL_NAME=Grand Hotel
HOTEL_GST_NUMBER=

# PayU's own SQLite bills DB — separate from crm_outputs/.
DB_PATH=data/payments.db

# Identical create-bill calls within this window return the same pending
# bill instead of creating a duplicate.
DEDUPE_WINDOW_SECONDS=120
# Pending bills older than this are auto-expired by the background sweep.
PENDING_BILL_TTL_MINUTES=30

LOG_LEVEL=INFO

# ═══════════════════════════════════════════════════════════════════
# Notifications — SMS (MSG91) + Email (SendGrid)
# Currently used by taxi_worker.py; will also be used to send PayU
# payment links to guests once notifications/ is wired in.
# ═══════════════════════════════════════════════════════════════════
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_TEMPLATE_ID_GUEST=
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
